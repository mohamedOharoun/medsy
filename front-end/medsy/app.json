{
  "expo": {
    "name": "medsy",
    "slug": "medsy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Medsy.png",
    "scheme": "medsy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Medsy.png",
        "backgroundImage": "./assets/images/Medsy.png",
        "monochromeImage": "./assets/images/Medsy.png",
        "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE"]
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Medsy.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/Medsy.png",
          "color": "#2E7D5E",
          "sounds": [],
          "iosDisplayInForeground": true
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
